# Copy to the repository root as `.gitattributes`. (Here it has no dot: a
# `.gitattributes` inside templates/ would strip templates/tests/ from this
# playbook's own archive downloads.)
#
# A release is `git archive` of its tag, so every path below stays out of it:
# a host gets only what runs. tests/test_release_archive.py fails an entry
# that names no tracked path, an internal file that ships, and a runtime file
# left out. Keep only the lines for what your repository has.

# for the people changing the code, and its CI: nothing on a host runs them
/.gitattributes export-ignore
/CLAUDE.md export-ignore
/.claude export-ignore
/tests export-ignore
/evals export-ignore
/.github export-ignore
/.gitlab-ci.yml export-ignore

# registry files no runtime code opens: ssot/index.tsv names no reader for them
/ssot/README.md export-ignore
/ssot/index.tsv export-ignore
/ssot/user-stories.tsv export-ignore
/ssot/user-stories.agent.tsv export-ignore
/ssot/policies.tsv export-ignore
/ssot/policies.agent.tsv export-ignore
/ssot/glossary.tsv export-ignore
/ssot/glossary.agent.tsv export-ignore

# an owner file only its test reads (the console's UI rules) goes here too
